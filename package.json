{
  "name": "overflow",
  "version": "22.0.0",
  "description": "Overflow : combats, Destin et butin dans Port-Saline engloutie.",
  "author": "ANDHIME",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node tools/build.js && node tools/www.js",
    "build:android": "npm run build && npx cap add android && node tools/android.js && npx cap sync android",
    "pc": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "build": {
    "appId": "fr.portsaline.overflow",
    "productName": "Overflow",
    "directories": { "output": "release", "buildResources": "assets" },
    "files": ["electron/**", "www/**", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "Overflow", "artifactName": "Overflow-Setup-${version}.${ext}" },
    "portable": { "artifactName": "Overflow-Portable-${version}.${ext}" },
    "linux": { "target": ["AppImage"], "category": "Game", "icon": "assets/icon.png", "artifactName": "Overflow-${version}.${ext}" }
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "electron": "43.7.3",
    "electron-builder": "26.16.1",
    "playwright": "1.56.1"
  }
}
